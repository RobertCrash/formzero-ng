{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "formzero",
	"compatibility_date": "2025-04-04",
	"compatibility_flags": [
        "nodejs_compat"
    ],
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "formzero",
			"database_id": "4a765081-eab0-424f-984b-e9b638a16de4",
		}
	],
	"r2_buckets": [
		{
			"binding": "UPLOADS",
			"bucket_name": "formzero-uploads"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "DELIVERY_QUEUE",
				"queue": "formzero-deliveries"
			}
		],
		"consumers": [
			{
				"queue": "formzero-deliveries",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 5,
				"dead_letter_queue": "formzero-deliveries-dlq"
			}
		]
	},
	"ratelimits": [
		{
			"name": "RATE_LIMIT_STRICT",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		},
		{
			"name": "RATE_LIMIT_STANDARD",
			"namespace_id": "1002",
			"simple": { "limit": 15, "period": 60 }
		},
		{
			"name": "RATE_LIMIT_RELAXED",
			"namespace_id": "1003",
			"simple": { "limit": 60, "period": 60 }
		}
	],
	"triggers": {
		"crons": ["17 3 * * *"]
	}
}