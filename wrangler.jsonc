{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "formzero",
	"compatibility_date": "2026-08-04",
	// nodejs_compat is required by nodemailer, which backs the optional custom
	// SMTP transport. The default Cloudflare Email Service transport does not
	// need it.
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	// database_id is intentionally omitted so forks and Deploy to Cloudflare
	// clones provision their own database. Wrangler links it on first deploy and
	// keeps it linked afterwards. Do not commit a database_id.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "formzero-ng"
		}
	],
	"r2_buckets": [
		{
			"bucket_name": "formzero-ng-uploads",
			"binding": "UPLOADS"
		}
	],
	// Add "remote": true locally to route wrangler dev sends through the real
	// Email Service. It is omitted here so a dev server cannot send real mail.
	"send_email": [
		{
			"name": "EMAIL"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "DELIVERY_QUEUE",
				"queue": "formzero-deliveries"
			}
		],
		"consumers": [
			{
				"queue": "formzero-deliveries",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 5,
				"dead_letter_queue": "formzero-deliveries-dlq"
			},
			// Without a consumer the dead-letter queue only accumulates and expires
			// messages. This one records the give-up on the delivery job so it is
			// visible in the dashboard and can be replayed from there.
			{
				"queue": "formzero-deliveries-dlq",
				"max_batch_size": 10,
				"max_batch_timeout": 30,
				"max_retries": 1
			}
		]
	},
	"ratelimits": [
		{
			"name": "RATE_LIMIT_STRICT",
			"namespace_id": "1001",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_STANDARD",
			"namespace_id": "1002",
			"simple": {
				"limit": 15,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_RELAXED",
			"namespace_id": "1003",
			"simple": {
				"limit": 60,
				"period": 60
			}
		}
	],
	"triggers": {
		"crons": [
			"17 3 * * *"
		]
	}
}