name: CI

on:
  push:
    branches: [main]
  pull_request:

# A newer push makes an in-flight run of the same ref irrelevant.
concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6

      - uses: actions/setup-node@v6
        with:
          node-version: 24
          cache: npm

      # `npm ci` triggers the postinstall `wrangler types` step, which is what
      # makes the generated `Env` in worker-configuration.d.ts match
      # wrangler.jsonc rather than whatever was last committed.
      - run: npm ci

      # Runs before the type check: a renamed binding is a silent runtime
      # outage, so it should fail here with a message naming the binding rather
      # than as a downstream type error.
      - run: npm run check:config

      # Fails on a high or critical advisory that is not recorded in
      # scripts/known-advisories.json, and on a recorded one whose review date
      # has passed.
      - run: npm run check:advisories

      - run: npm test

      - run: npm run typecheck

      - run: npm run build
