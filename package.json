{
	"name": "formzero",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"migrate": "yes Y | wrangler d1 migrations apply DB",
		"seed": "yes Y | wrangler d1 execute DB --file seed.sql",
		"cf-typegen": "wrangler types",
		"deploy": "npm run build && npm run migrate -- --remote && wrangler deploy",
		"deploy:init": "npm run build && wrangler deploy && npm run migrate -- --remote",
		"check:config": "tsx scripts/check-wrangler-config.ts",
		"check:advisories": "tsx scripts/check-advisories.ts",
		"dev": "react-router dev",
		"postinstall": "npm run cf-typegen",
		"preview": "npm run build && vite preview",
		"test": "vitest run --config vitest.config.ts",
		"typecheck": "npm run cf-typegen && react-router typegen && tsc -b",
		"better-auth-generate": "@better-auth/cli@latest generate --output migrations/change-this-name.sql --config better-auth/config.ts --y",
		"env": "dotenv -e .dev.vars --",
		"env:prod": "dotenv -e .dev.vars.production --"
	},
	"dependencies": {
		"@radix-ui/react-avatar": "^1.1.11",
		"@radix-ui/react-collapsible": "^1.1.12",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-tabs": "^1.1.13",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@tanstack/react-table": "^8.21.3",
		"better-auth": "^1.4.18",
		"better-sqlite3": "^12.6.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"dotenv-cli": "^10.0.0",
		"isbot": "^5.1.34",
		"kysely-d1": "^0.4.0",
		"lucide-react": "^0.563.0",
		"next-themes": "^0.4.6",
		"nodemailer": "^9.0.3",
		"prism-react-renderer": "^2.4.1",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-router": "^7.18.1",
		"recharts": "^2.15.4",
		"tailwind-merge": "^3.4.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.21.0",
		"@cloudflare/vitest-pool-workers": "^0.18.8",
		"@react-router/dev": "^7.18.1",
		"@tailwindcss/vite": "^4.1.18",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^22.19.7",
		"@types/nodemailer": "^7.0.9",
		"@types/react": "^19.2.10",
		"@types/react-dom": "^19.2.3",
		"jsonc-parser": "^3.3.1",
		"tailwindcss": "^4.1.18",
		"tsx": "^4.21.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.2",
		"vite": "^7.3.1",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^4.1.10",
		"wrangler": "^4.60.0"
	},
	"cloudflare": {
		"bindings": {
			"BETTER_AUTH_SECRET": {
				"description": "Required authentication secret. Generate a unique value with `openssl rand -hex 32` or a 256-bit hexadecimal value at [JWT Secrets](https://jwtsecrets.com/), and keep it unchanged across deployments."
			},
			"FORMZERO_ENCRYPTION_KEY": {
				"description": "Optional encryption key for stored credentials: custom SMTP passwords, per-form Turnstile secrets, and webhook signing secrets. Exactly 32 bytes as 64 hexadecimal characters (`openssl rand -hex 32`) or base64. Not needed when email uses the built-in Cloudflare Email Service transport. Changing it makes previously stored credentials unreadable."
			}
		}
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"esbuild@0.27.2": true,
		"better-sqlite3@12.6.2": true,
		"workerd@1.20260722.1": true
	}
}
